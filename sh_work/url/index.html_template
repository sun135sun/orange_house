  <body>
    <div class="container">
      <h1>正在为你跳转最新可用的访问域名，请稍候.....</h1>

      <div class="loading-container">
        <div class="loading-spinner"></div>
        <div class="loading-text">
          <a href="javascript:noWait()">无需等待，点击进入。</a>
        </div>
      </div>

      <div class="progress-bar">
        <div class="progress"></div>
      </div>

      <div class="hint">如果长时间没有跳转，请检查网络连接</div>
    </div>

    <span class="time"></span>

    <script>
      var sub_str = "TSub";
      var tdn_str = "TDname";
      var html_go = "https://" + sub_str + "." + tdn_str;
      html_go += ".top";
      html_go += "/ohohoh/";

      function noWait() {
        var Uhttp = document.referrer;
        Uhttp = Uhttp.replace("https://", "");
        Uhttp = Uhttp.replace("http://", "");

        if (Uhttp.indexOf("/") != -1) {
          Uhttp = Uhttp.substring(0, Uhttp.indexOf("/"));
        }
        if (Uhttp.indexOf("?") != -1) {
          Uhttp = Uhttp.substring(0, Uhttp.indexOf("?"));
        }
        if (Uhttp.substr(-1) == "/") {
          Uhttp = Uhttp.substring(0, Uhttp.length - 1);
        }
        location.href = html_go + "?link=" + Uhttp;
      }

      var t = 1;
      var time = document.getElementsByClassName("time")[0];
      function fun() {
        t--;
        time.innerHTML = t;
        if (t <= 0) {
          var Uhttp = document.referrer;
          Uhttp = Uhttp.replace("https://", "");
          Uhttp = Uhttp.replace("http://", "");
          if (Uhttp.indexOf("/") != -1) {
            Uhttp = Uhttp.substring(0, Uhttp.indexOf("/"));
          }
          if (Uhttp.indexOf("?") != -1) {
            Uhttp = Uhttp.substring(0, Uhttp.indexOf("?"));
          }
          if (Uhttp.substr(-1) == "/") {
            Uhttp = Uhttp.substring(0, Uhttp.length - 1);
          }
          location.href = html_go + "?link=" + Uhttp;
          clearInterval(inter);
        }
      }
      var inter = setInterval("fun()", 500);
    </script>
  </body>
</html>
