    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #dae1e8ff;
        color: rgba(4, 7, 9, 0.95);
        font-family: "Microsoft YaHei", Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        text-align: center;
        padding: 20px;
      }

      .container {
        max-width: 600px;
        width: 100%;
      }

      h1 {
        font-size: 28px;
        margin-bottom: 30px;
        font-weight: 500;
      }

      .loading-container {
        margin: 40px 0;
      }

      .loading-spinner {
        width: 60px;
        height: 60px;
        border: 5px solid rgba(183, 202, 215, 0.3);
        border-top: 5px solid #7999aeff;
        border-radius: 50%;
        margin: 0 auto 20px;
        animation: spin 1.5s linear infinite;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      .loading-text {
        font-size: 18px;
        margin-bottom: 10px;
      }
      .loading-text a {
        font-size: 18px;
        margin-bottom: 10px;
        color: rgba(234, 239, 242, 0.95);
      }

      .progress-bar {
        width: 100%;
        height: 6px;
        background-color: rgba(52, 152, 219, 0.2);
        border-radius: 3px;
        overflow: hidden;
        margin: 20px auto;
      }

      .progress {
        height: 100%;
        width: 0%;
        background-color: #3498db;
        animation: progress 5s linear forwards;
      }

      @keyframes progress {
        0% {
          width: 0%;
        }
        100% {
          width: 100%;
        }
      }

      .hint {
        font-size: 14px;
        color: rgba(52, 152, 219, 0.7);
        margin-top: 30px;
      }

      /* 响应式设计 */
      @media (max-width: 480px) {
        h1 {
          font-size: 22px;
        }

        .loading-text {
          font-size: 16px;
        }
        .loading-text a {
          color: rgba(234, 239, 242, 0.95);
